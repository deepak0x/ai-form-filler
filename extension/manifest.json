{
  "manifest_version": 3,
  "name": "AI Form Filler (Local Claude)",
  "version": "1.1",
  "description": "Scans any web form (Google Forms or plain HTML) on click and fills it from your profile using your local Claude Code subscription. No API key.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8731/*"
  ],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Form Filler",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
